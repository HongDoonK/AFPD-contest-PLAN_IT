# 이 파일을 .env로 복사해 값을 채운다. .env는 저장소에 올리지 않는다.
# 코드는 .env를 직접 읽지 않고 환경변수만 본다. 불러오는 방법은 README의 '환경설정' 참고.

# --- 문장 생성 LLM (없어도 실행됨: none이면 템플릿 문장을 쓴다) ---
# none | server(OpenAI 호환) | anthropic(Anthropic Messages 형식) | local(transformers)
LLM_PROVIDER=none
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
# 추론 모델은 none으로 꺼야 빈 응답이 나오지 않는다 (예: gpt-6-luna)
LLM_REASONING_EFFORT=none
LLM_TIMEOUT=120

# --- 주 모델의 토큰이 떨어졌을 때 넘어갈 예비 모델 (선택) ---
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=

# --- 정책 DB를 새로 수집할 때만 필요 (저장소의 압축 DB를 쓰면 비워 둔다) ---
# 금융감독원 금융상품 한눈에: https://finlife.fss.or.kr
FINLIFE_API_KEY=
# 공공데이터포털 한국사회보장정보원 복지서비스: https://www.data.go.kr
BOKJIRO_API_KEY=
