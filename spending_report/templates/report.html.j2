{% set calc = r.calculations %}
{% set effect = calc.effect %}
{% set table = calc.cashflow %}
{% set saving = calc.metrics | selectattr("code", "equalto", "저축률") | first %}
{% set consumption = calc.metrics | selectattr("code", "equalto", "소비") | first %}
{% set benefits = r.findings.policy_benefits %}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>소비습관 개선 보고서</title>
<style>
:root { --ink:#1c2430; --muted:#5f6b7a; --rule:#d9dee5; --strong-rule:#1c2430; --accent:#0f6b63; --tint:#eef6f4; --warn:#a15c00; --paper:#fff; }
* { box-sizing:border-box; }
body { margin:0; background:var(--paper); color:var(--ink); font:15px/1.65 Pretendard,"Noto Sans KR","Malgun Gothic",system-ui,sans-serif; }
main { max-width:900px; margin:0 auto; padding:48px 24px 72px; }
header { border-bottom:2px solid var(--strong-rule); padding-bottom:18px; }
.eyebrow { color:var(--muted); font-size:13px; margin:0 0 6px; }
h1 { font-size:28px; line-height:1.3; margin:0 0 10px; letter-spacing:-.01em; }
.meta { color:var(--muted); font-size:14px; margin:0; }
.status { color:var(--warn); font-size:14px; font-weight:600; margin:8px 0 0; }
section { margin-top:40px; }
h2 { font-size:19px; line-height:1.4; margin:0 0 12px; }
h3 { font-size:15px; margin:22px 0 8px; }
.part { margin:48px 0 -16px; padding-top:12px; border-top:2px solid var(--strong-rule); color:var(--muted); font-weight:700; }
p { margin:0 0 10px; }
.lead { font-size:17px; line-height:1.7; }
.note { color:var(--muted); font-size:13px; }
.scroll { overflow-x:auto; }
table { width:100%; border-collapse:collapse; font-size:14px; }
th { color:var(--muted); font-weight:600; text-align:left; border-bottom:1px solid var(--strong-rule); padding:7px 8px; white-space:nowrap; }
td { border-bottom:1px solid var(--rule); padding:7px 8px; vertical-align:top; }
.num { text-align:right; font-variant-numeric:tabular-nums; white-space:nowrap; }
th.num { text-align:right; }
.kpi th { border-bottom:none; padding:0 8px 2px; font-size:13px; }
.kpi td { border-bottom:none; padding:0 8px; font-size:22px; font-weight:700; letter-spacing:-.01em; white-space:nowrap; }
.kpi .sub { font-size:13px; font-weight:400; color:var(--muted); }
.kpi-wrap { border-top:1px solid var(--rule); border-bottom:1px solid var(--rule); padding:14px 0; margin-top:16px; }
.block { font-weight:700; white-space:nowrap; }
tr.changed td { background:var(--tint); }
tr.changed td.after { font-weight:700; color:var(--accent); }
tr.reserve td { font-style:italic; }
tr.unknown td { color:var(--muted); }
tr.subtotal td { font-weight:700; border-bottom:1px solid var(--strong-rule); }
tr.grand td { font-weight:700; border-top:2px solid var(--strong-rule); border-bottom:2px solid var(--strong-rule); }
td.minus { color:var(--accent); }
ol, ul { margin:0; padding-left:20px; }
li { margin:3px 0; }
a { color:var(--accent); overflow-wrap:anywhere; }
@media print { main { max-width:none; padding:0; } section { break-inside:avoid-page; } body { font-size:12.5px; } }
</style>
</head>
<body>
<main>
<header>
  <p class="eyebrow">Fact Finding 7번 현금흐름표 기준 · 기준일 {{ r.as_of_date }}</p>
  <h1>소비습관 개선 보고서</h1>
  <p class="meta">{{ r.customer.name }} · 만 {{ r.customer.age }}세 · {{ r.customer.occupation }} · {{ r.customer.region }}</p>
  <p class="status">{% if r.is_synthetic %}가상 고객 · {% endif %}{{ r.review.state }} · 고객 선택 {{ r.review.customer_choice }} · 시뮬레이션 결과</p>
</header>

<section>
  <h2>1. 한눈에 보기</h2>
  <p class="lead">{{ r.narrative.summary.text }}</p>
  <div class="kpi-wrap scroll">
  {% if table.totals.complete %}
  <table class="kpi">
    <tr><th>월 여유 자금</th><th>연 환산</th><th>저축률</th><th>소비지출 비중</th></tr>
    <tr>
      <td>{{ effect.monthly_freed_won | won }}</td>
      <td>{{ effect.annual_freed_won | won }}</td>
      <td>{{ metric_value(saving.after, "pct") }} <span class="sub">현재 {{ metric_value(saving.before, "pct") }}</span></td>
      <td>{{ metric_value(consumption.after, "pct") }} <span class="sub">현재 {{ metric_value(consumption.before, "pct") }}</span></td>
    </tr>
  </table>
  {% else %}
  <table class="kpi">
    <tr><th>금액이 있는 지출 행</th><th>쓰임 미확인 금액</th><th>확인된 절감</th><th>확인할 사항</th></tr>
    <tr>
      <td>{{ table.totals.known_rows }} / {{ table.totals.known_rows + table.totals.unknown_rows }}</td>
      <td>{% if table.totals.income_before_won %}약 {{ table.totals.unexplained_won | won }}{% else %}계산 불가{% endif %}{% if table.totals.income_before_won %} <span class="sub">범위 {{ table.totals.unexplained_range_won[0] | won }} ~ {{ table.totals.unexplained_range_won[1] | won }}</span>{% endif %}</td>
      <td>월 {{ effect.monthly_freed_won | won }}</td>
      <td>{{ r.questions | length }}건</td>
    </tr>
  </table>
  {% endif %}
  </div>
  {% if effect.annual_note %}<p class="note" style="margin-top:8px">연 환산 참고: {{ effect.annual_note }}.</p>{% endif %}
</section>

<section>
  <h2>2. 현금흐름표 적용 전·후</h2>
  <p class="note">단위 만원, 월 기준. 정책 혜택은 기관 선정 전, 소비 조정은 고객 선택 전의 값입니다.{% if not table.totals.complete %} '미확인'은 고객이 적지 않은 칸이며 0원으로 계산하지 않았습니다. ≈와 범위는 고객의 어림값입니다.{% endif %}</p>
  <div class="scroll">
  <table>
    <thead><tr><th>구분</th><th>항목</th><th class="num">적용 전</th><th class="num">정책 혜택</th><th class="num">소비 조정</th><th class="num">적용 후</th><th class="num">증감</th></tr></thead>
    <tbody>
    {% for row in table.income %}
      <tr class="{{ 'unknown' if row.before_won is none }}"><td class="block">{% if loop.first %}수입{% endif %}</td><td>{{ row.label }}</td><td class="num">{{ cell_text(row) }}</td><td class="num"></td><td class="num"></td><td class="num after">{{ cell_text(row, "after_won") }}</td><td class="num"></td></tr>
    {% endfor %}
      <tr class="subtotal"><td></td><td>수입 합계{% if not table.totals.complete %} (적힌 값만){% endif %}</td><td class="num">{{ table.totals.income_before_won | manwon }}</td><td class="num"></td><td class="num"></td><td class="num">{{ table.totals.income_after_won | manwon }}</td><td class="num"></td></tr>
    {% for block in table.blocks %}
      {% for row in block.rows %}
      <tr class="{{ 'changed' if row.changed }}{{ ' reserve' if row.is_reserve }}{{ ' unknown' if row.before_won is none }}"><td class="block">{% if loop.first %}{{ block.block }}{% endif %}</td><td>{{ row.label }}</td><td class="num">{{ cell_text(row) }}</td><td class="num minus">{{ row.policy_won | reduction }}</td><td class="num minus">{{ row.adjustment_won | reduction }}</td><td class="num after">{{ cell_text(row, "after_won") }}</td><td class="num">{{ row.delta_won | change }}</td></tr>
      {% endfor %}
      <tr class="subtotal"><td></td><td>{{ block.block }} 소계{% if not table.totals.complete %} (적힌 값만){% endif %}</td><td class="num">{{ block.subtotal.before_won | manwon }}</td><td class="num"></td><td class="num"></td><td class="num">{{ block.subtotal.after_won | manwon }}</td><td class="num">{{ block.subtotal.delta_won | change }}</td></tr>
    {% endfor %}
      <tr class="grand"><td></td><td>지출 합계{% if not table.totals.complete %} (적힌 값만){% endif %}</td><td class="num">{{ table.totals.outflow_before_won | manwon }}</td><td class="num"></td><td class="num"></td><td class="num">{{ table.totals.outflow_after_won | manwon }}</td><td class="num"></td></tr>
      {% if not table.totals.complete and table.totals.income_before_won %}<tr><td></td><td>쓰임 미확인 금액 (수입 − 적힌 지출)</td><td class="num">≈{{ table.totals.unexplained_won | manwon }}</td><td class="num"></td><td class="num"></td><td class="num"></td><td class="num"></td></tr>{% endif %}
      <tr><td></td><td>미확인 수입 / 미확인 지출</td><td class="num">{{ table.totals.unverified_income_won | manwon }} / {{ table.totals.unverified_outflow_won | manwon }}</td><td class="num"></td><td class="num"></td><td class="num">{{ table.totals.unverified_income_won | manwon }} / {{ table.totals.unverified_outflow_won | manwon }}</td><td class="num"></td></tr>
    </tbody>
  </table>
  </div>
</section>

<section>
  <h2>3. 현재 소비 진단</h2>
  {% set dx = calc.diagnosis %}
  {% if dx.available %}
  <p>저축·보험·세금을 뺀 소비지출 {{ dx.consumption_won | won }} 가운데 방법을 바꾸거나 줄일 여지가 있는 지출은 {{ dx.flexible_share_pct }}%입니다.</p>
  <div class="scroll">
  <table>
    <thead><tr><th>구분</th><th>뜻</th><th class="num">적용 전</th><th class="num">비중</th><th class="num">적용 후</th><th class="num">증감</th></tr></thead>
    <tbody>
    {% set meaning = {"필수": "생활과 일을 유지하는 데 필요", "일부조정": "방법을 바꿔 일부 줄일 수 있음", "선택": "고객 선택에 따라 줄일 수 있음", "미확인": "고객 판단이나 자료 확인 필요"} %}
    {% for g in dx.by_necessity %}
      <tr><td>{{ g.necessity }}</td><td>{{ meaning[g.necessity] }}</td><td class="num">{{ g.before_won | manwon }}</td><td class="num">{{ g.share_pct }}%</td><td class="num">{{ g.after_won | manwon }}</td><td class="num">{{ g.change_won | change }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% if dx.top_flexible %}<p class="note" style="margin-top:8px">조정 여지가 큰 항목: {% for t in dx.top_flexible %}{{ t.label }} {{ t.monthly_won | manwon }}만원({{ t.share_pct }}%){{ ", " if not loop.last }}{% endfor %}</p>{% endif %}
  {% else %}
  <p>지출 칸이 비어 있어 소비 구성을 계산하지 않았습니다. 빈칸을 뺀 채로 비중을 내면 실제와 달라집니다.</p>
  {% endif %}
</section>

<section>
  <h2>4. 소비습관 개선안</h2>
  {% set coaching = r.narrative.coaching %}
  <div class="scroll">
  <table>
    <thead><tr><th>구분</th><th>대상</th><th class="num">적용 전</th><th class="num">적용 후</th><th>상태</th><th>실천 제안과 가정</th></tr></thead>
    <tbody>
    {% for rec in r.recommendations %}
      {% set tip = coaching | selectattr("rec_id", "equalto", rec.id) | first %}
      <tr>
        <td style="white-space:nowrap">{{ rec.kind }}</td>
        <td>{{ rec.target }}</td>
        <td class="num">{{ rec.amount.before_won | manwon }}</td>
        <td class="num">{{ rec.amount.after_won | manwon }}</td>
        <td style="white-space:nowrap">{{ rec.certainty }}</td>
        <td>{{ tip.text if tip else rec.action }}{% if rec.tradeoff %}<br><span class="note">고려할 점: {{ rec.tradeoff }}</span>{% endif %}{% for a in rec.assumptions %}<br><span class="note">{{ a }}</span>{% endfor %}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% if not r.recommendations %}<p>지금 적힌 금액만으로는 바꿀 항목을 정할 수 없습니다.</p>{% endif %}
  {% if r.conditional_options %}
  <h3>자료가 확인되면 검토할 대안</h3>
  <div class="scroll">
  <table>
    <thead><tr><th>대상</th><th>조건</th><th class="num">월 절감 범위</th><th>가정</th></tr></thead>
    <tbody>
    {% for c in r.conditional_options %}
      <tr><td>{{ c.target }}</td><td>{{ c.condition }}</td><td class="num">{{ c.monthly_range_won[0] | won }}~{{ c.monthly_range_won[1] | won }}</td><td>{{ (c.assumptions + c.dependencies) | join(", ") }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% endif %}
  <p class="note" style="margin-top:10px">{{ r.narrative.closing.text }}</p>
</section>

<section>
  <h2>5. 기대효과</h2>
  <div class="scroll">
  <table>
    <thead><tr><th>지표</th><th class="num">적용 전</th><th class="num">적용 후</th><th>계산식</th></tr></thead>
    <tbody>
    {% for m in calc.metrics if table.totals.complete or m.before is not none %}
      <tr><td>{{ m.name }}</td><td class="num">{{ metric_value(m.before, m.unit) }}</td><td class="num">{{ metric_value(m.after, m.unit) }}</td><td>{{ m.formula }}{% if m.note %}<br><span class="note">{{ m.note }}</span>{% endif %}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% if table.totals.complete %}
  <h3>시나리오 비교</h3>
  <div class="scroll">
  <table>
    <thead><tr><th>시나리오</th><th class="num">월 여유 자금</th><th class="num">저축률</th><th class="num">소비지출 비중</th></tr></thead>
    <tbody>
    {% for s in calc.scenarios %}
      <tr><td>{{ s.name }}</td><td class="num">{{ s.monthly_freed_won | won }}</td><td class="num">{{ metric_value(s.saving_rate_pct, "pct") }}</td><td class="num">{{ metric_value(s.consumption_ratio_pct, "pct") }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  <p class="note" style="margin-top:8px">세후 가용소득 {{ calc.basis.disposable_won | won }} 기준입니다.</p>
  {% else %}
  <p class="note" style="margin-top:8px">저축률, 소비지출 비중, 유동성 지표는 7번의 자료를 받은 뒤 계산합니다.</p>
  {% endif %}
</section>

<section>
  <h2>6. 실행과 점검 계획</h2>
  {% set plan = r.action_plan %}
  <div class="scroll">
  <table>
    <thead><tr><th>언제</th><th>담당</th><th>할 일</th><th>점검 기준</th></tr></thead>
    <tbody>
    {% for item in plan["items"] %}
      <tr><td style="white-space:nowrap">{{ item.when }}</td><td style="white-space:nowrap">{{ item.owner }}</td><td>{{ item.action }}</td><td>{{ item.check }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  <p style="margin-top:10px">1차 점검: {{ plan.first_check }} · 재평가: {{ plan.review }}</p>
  {% if plan.metrics %}<p class="note">매달 볼 숫자: {% for m in plan.metrics %}{{ m.name }} {{ m.target_won | won }}{{ ", " if not loop.last }}{% endfor %}</p>{% endif %}
  <p class="note">다시 계산할 때: {{ plan.review_triggers | join(" / ") }}</p>
</section>

<section>
  <h2>7. 확인이 필요한 사항</h2>
  {% if r.data_requests %}
  <div class="scroll">
  <table>
    <thead><tr><th class="num">순서</th><th>받을 자료</th><th>필요한 이유</th><th>받으면 계산되는 것</th></tr></thead>
    <tbody>
    {% for q in r.data_requests %}
      <tr><td class="num">{{ q.priority }}</td><td>{{ q.item }}</td><td>{{ q.why }}</td><td>{{ q.unlocks }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% endif %}
  {% if r.questions_other %}
  {% if r.data_requests %}<h3>그 밖의 질문</h3>{% endif %}
  <ol>{% for q in r.questions_other %}<li>{{ q }}</li>{% endfor %}</ol>
  {% endif %}
  {% if r.missing_fields %}<p class="note" style="margin-top:10px">아직 입력되지 않은 항목: {% for name in r.missing_fields %}{{ name | field_label }}{{ ", " if not loop.last }}{% endfor %}</p>{% endif %}
</section>

<p class="part">부록</p>

<section>
  <h2>8. 그대로 두는 항목</h2>
  <div class="scroll">
  <table>
    <thead><tr><th>이유</th><th>항목</th></tr></thead>
    <tbody>
    {% for group in r.findings.kept %}
      <tr><td>{{ group.reason }}</td><td>{% for item in group["items"] %}{{ item.label }}{% if item.monthly_won is not none %} {{ item.monthly_won | manwon }}{% endif %}{{ ", " if not loop.last }}{% endfor %}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</section>

<section>
  <h2>9. 정책 혜택 안내</h2>
  {% macro policy_table(items, show_conditions=false) %}
  <div class="scroll">
  <table>
    <thead><tr><th>정책</th><th>효과</th><th>마감</th><th>{{ "남은 확인 사항" if show_conditions else "안내" }}</th></tr></thead>
    <tbody>
    {% for p in items %}
      <tr><td>{% if p.url %}<a href="{{ p.url if p.url.startswith('http') else 'https://' ~ p.url }}">{{ p.name }}</a>{% else %}{{ p.name }}{% endif %}{% if p.row %}<br><span class="note">{{ p.row }}</span>{% endif %}</td><td style="white-space:nowrap">{{ p.effect }}</td><td style="white-space:nowrap">{{ p.deadline | ymd or "상시 또는 공고 확인" }}</td><td>{% if show_conditions %}{{ p.open_conditions | join(", ") or "공고 확인" }}{% else %}{{ p.basis or "" }}{% if p.note %}<br><span class="note">{{ p.note }}</span>{% endif %}{% endif %}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% endmacro %}
  <h3>표에 반영한 정책</h3>
  {% if benefits.applied %}{{ policy_table(benefits.applied) }}{% else %}<p>표에 반영한 정책이 없습니다.</p>{% endif %}
  {% if benefits.other_scenario %}<h3>입력상 충족이지만 표에 넣지 않은 정책 (일시금, 일부 지출 대상 등)</h3>{{ policy_table(benefits.other_scenario) }}{% endif %}
  {% if benefits.needs_check %}<h3>조건 확인이 필요한 정책</h3>{{ policy_table(benefits.needs_check, true) }}{% endif %}
  {% if benefits.savings_programs %}
  <h3>저축 정책</h3>
  <div class="scroll">
  <table>
    <thead><tr><th>정책</th><th>상태</th><th>마감</th><th>안내</th></tr></thead>
    <tbody>
    {% for s in benefits.savings_programs %}
      <tr><td>{% if s.url %}<a href="{{ s.url if s.url.startswith('http') else 'https://' ~ s.url }}">{{ s.name }}</a>{% else %}{{ s.name }}{% endif %}</td><td style="white-space:nowrap">{{ s.certainty }}</td><td style="white-space:nowrap">{{ s.deadline | ymd or "상시 또는 공고 확인" }}</td><td>{{ s.note }}{% if s.open_conditions %}<br><span class="note">{{ s.open_conditions | join(", ") }}</span>{% endif %}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% endif %}
  <p class="note" style="margin-top:8px">소비 계획에서 뺀 정책: 대출·보증 수단 {{ benefits.excluded_counts.debt_instruments }}건, 특정 집단 대상 미확인 {{ benefits.excluded_counts.targeted_group_unverified }}건, 이사가 필요한 입주형 주거 지원 {{ benefits.excluded_counts.housing_move }}건, 그 밖의 서비스 {{ benefits.excluded_counts.other_services }}건.</p>
</section>

<section>
  <h2>10. 소득·세금 참고</h2>
  {% set tax = r.findings.income_tax_reference %}
  <p class="note">{{ tax.source }}</p>
  <div class="scroll">
  <table>
    <thead><tr><th>항목</th><th class="num">금액</th></tr></thead>
    <tbody>
    {% for row in tax.rows %}
      <tr><td>{{ row.label }}</td><td class="num">{{ metric_value(row.value, row.unit) }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  <p class="note" style="margin-top:8px">{{ tax.note }}</p>
  {% if r.findings.deduction_flags %}
  <h3>확인할 공제와 일시 유입</h3>
  <div class="scroll">
  <table>
    <thead><tr><th>항목</th><th>발견한 내용</th><th>확인할 일</th></tr></thead>
    <tbody>
    {% for f in r.findings.deduction_flags %}
      <tr><td>{{ f.item }}</td><td>{{ f.finding }}</td><td>{{ f.check }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% endif %}
</section>

<section>
  <h2>11. 근거와 검토 기록</h2>
  <h3>원본 문서 대조</h3>
  <div class="scroll">
  <table>
    <thead><tr><th>문서</th><th>결과</th><th>내용</th></tr></thead>
    <tbody>
    {% for key, doc in r.evidence.documents.items() %}
      <tr><td>{{ doc.file }}</td><td style="white-space:nowrap">{{ doc.status }}</td><td>{% if doc.reason %}{{ doc.reason }}{% else %}{{ doc.rows_checked }}개 항목 대조{% if doc.rows_blank %}, 빈칸 {{ doc.rows_blank }}개{% endif %}{% if doc.fields_parsed %}, {{ doc.fields_parsed }}개 항목 분류{% endif %}{% for d in doc.differences %}<br>{{ d }}{% endfor %}{% endif %}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  <h3>AI 사용</h3>
  <p>{% if r.ai_usage.provider == "none" %}LLM을 사용하지 않았고 모든 문장은 계산 결과로 만든 템플릿입니다.{% else %}{{ r.ai_usage.model }} ({{ r.ai_usage.provider }}). 문장 {{ r.ai_usage.sentences_llm }}개는 LLM, {{ r.ai_usage.sentences_template }}개는 템플릿입니다. 프롬프트와 답변은 {{ r.ai_usage.log_file }}에 기록했습니다.{% endif %} 금액과 비율은 계산 엔진이 정합니다.</p>
  <h3>한계</h3>
  <ul>{% for item in r.limitations %}<li>{{ item }}</li>{% endfor %}</ul>
  <h3>검토 상태</h3>
  <table>
    <tr><td>담당자 검토</td><td>{{ r.review.state }}</td></tr>
    <tr><td>고객 선택</td><td>{{ r.review.customer_choice }}</td></tr>
    <tr><td>정책 정보 기준일</td><td>{{ r.evidence.policy_source.policy_db_as_of }}</td></tr>
    <tr><td>규칙 버전</td><td>{{ r.evidence.rules_version }}</td></tr>
  </table>
</section>
</main>
</body>
</html>
